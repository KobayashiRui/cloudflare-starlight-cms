{
  "name": "cloudflare-starlight-cms",
  "description": "A self-hosted documentation CMS for Astro Starlight, built on Cloudflare Workers, D1, R2, and Access.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "build": "astro build && node scripts/build-admin.mjs",
    "build:empty": "CMS_INITIAL_EMPTY=1 npm run build",
    "dev": "node scripts/dev.mjs",
    "check": "CMS_INITIAL_EMPTY=1 astro check && tsc --noEmit && npm run check:admin && npm run check:linux-lock",
    "check:admin": "tsc -p tsconfig.admin.json --noEmit",
    "check:linux-lock": "node scripts/check-linux-bindings.mjs",
    "test": "vitest run",
    "migrate:local": "wrangler d1 migrations apply DB --local",
    "migrate:remote": "wrangler d1 migrations apply DB --remote",
    "deploy": "wrangler deploy",
    "typegen": "wrangler types worker-configuration.d.ts --env-interface CloudflareBindings",
    "dry-run": "wrangler deploy --dry-run",
    "release:check": "npm --prefix packages/create-starlight-cms run release:check",
    "release:dry-run": "npm --prefix packages/create-starlight-cms run release:dry-run",
    "publish:cli": "npm --prefix packages/create-starlight-cms run publish:public"
  },
  "dependencies": {
    "@astrojs/check": "0.9.10",
    "@astrojs/starlight": "0.42.0",
    "@floating-ui/react": "0.27.20",
    "@headless-tree/core": "1.7.0",
    "@headless-tree/react": "1.7.0",
    "@radix-ui/react-dropdown-menu": "2.1.24",
    "@radix-ui/react-popover": "1.1.23",
    "@tiptap/core": "3.31.3",
    "@tiptap/extension-find-and-replace": "3.31.3",
    "@tiptap/extension-highlight": "3.31.3",
    "@tiptap/extension-horizontal-rule": "3.31.3",
    "@tiptap/extension-image": "3.31.3",
    "@tiptap/extension-link": "3.31.3",
    "@tiptap/extension-list": "3.31.3",
    "@tiptap/extension-subscript": "3.31.3",
    "@tiptap/extension-superscript": "3.31.3",
    "@tiptap/extension-table": "3.31.3",
    "@tiptap/extension-table-cell": "3.31.3",
    "@tiptap/extension-table-header": "3.31.3",
    "@tiptap/extension-table-row": "3.31.3",
    "@tiptap/extension-text-align": "3.31.3",
    "@tiptap/extension-typography": "3.31.3",
    "@tiptap/extension-youtube": "3.31.3",
    "@tiptap/extensions": "3.31.3",
    "@tiptap/pm": "3.31.3",
    "@tiptap/react": "3.31.3",
    "@tiptap/starter-kit": "3.31.3",
    "astro": "7.3.2",
    "clsx": "2.1.1",
    "drizzle-orm": "0.45.2",
    "github-slugger": "2.0.0",
    "hono": "4.13.7",
    "lodash.throttle": "4.1.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-hotkeys-hook": "5.3.3",
    "zod": "4.6.4"
  },
  "devDependencies": {
    "@base-ui/react": "1.8.0",
    "@types/lodash.throttle": "4.1.9",
    "@types/node": "22.20.1",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "class-variance-authority": "0.7.1",
    "esbuild": "0.28.2",
    "miniflare": "5.20260908.0-alpha",
    "sass-embedded": "1.104.0",
    "typescript": "5.9.3",
    "vitest": "5.0.0",
    "wrangler": "4.130.0"
  },
  "optionalDependencies": {
    "@astrojs/compiler-binding-linux-x64-gnu": "0.4.0",
    "@bruits/satteri-linux-x64-gnu": "0.10.5",
    "@esbuild/linux-x64": "0.28.1",
    "@img/sharp-libvips-linux-x64": "1.3.1",
    "@img/sharp-linux-x64": "0.35.2",
    "@pagefind/linux-x64": "1.5.2",
    "@rolldown/binding-linux-x64-gnu": "1.2.7",
    "lightningcss-linux-x64-gnu": "1.33.0"
  }
}
