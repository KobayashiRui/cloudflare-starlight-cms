{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "cloudflare-starlight-cms",
  "main": "./src/index.ts",
  "compatibility_date": "2026-09-09",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": ["/admin", "/admin/*", "!/admin/app.js", "!/admin/app.css"]
  },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "starlight-cms-local",
    "migrations_dir": "./migrations"
  }],
  "r2_buckets": [{ "binding": "MEDIA_BUCKET", "bucket_name": "starlight-cms-media" }],
  "observability": { "enabled": true, "head_sampling_rate": 1 }
}
